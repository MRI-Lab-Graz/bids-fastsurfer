{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fast-surfer-workshop/configs/flex/study.schema.json",
  "title": "flex study definition",
  "description": "Single definition file driving the flex pipeline: datalad ingest -> tidy extraction -> generic statistical battery. See docs/FLEX_PIPELINE.md.",
  "type": "object",
  "required": ["study", "datasets", "measures", "design", "analyses", "output"],
  "additionalProperties": false,
  "properties": {
    "study": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "label": {"type": "string"}
      }
    },

    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "datalad": {"type": "boolean", "default": false},
          "dir_pattern": {"type": "string"},
          "subject_id_map": {
            "type": "string",
            "description": "Optional short_id/long_id/match_type TSV (see scripts/build_hipsta_subject_id_map.py) when this dataset's own directory names use different subject IDs than --design.participants. Unmapped short IDs are skipped and logged, never guessed."
          }
        }
      }
    },

    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "baseline": {"type": "string"}
      }
    },

    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dataset", "source", "profile"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "dataset": {"type": "string"},
          "source": {
            "type": "string",
            "enum": ["aseg", "aparc", "aparc.a2009s", "hippo-amygdala", "thalamus", "brainstem", "hipsta"]
          },
          "metric": {"type": "string"},
          "profile": {"type": "string"},
          "region_filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prefix": {"type": "string"},
              "include": {"type": "array", "items": {"type": "string"}}
            }
          },
          "roi_set": {
            "oneOf": [
              {"type": "array", "items": {"type": "string"}, "minItems": 1},
              {"const": "all"}
            ]
          },
          "roi_column": {"type": "string", "default": "region"},
          "region_groups": {"type": "string"},
          "pointwise": {"type": "boolean", "default": false}
        }
      }
    },

    "profiles": {
      "description": "Custom measure profiles, merged with the built-ins (volume, thickness, volume_midline). Each profile is exactly {transform, etiv_covariate, hemisphere}.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["transform", "etiv_covariate", "hemisphere"],
        "additionalProperties": false,
        "properties": {
          "transform": {"type": "string", "enum": ["log", "identity"]},
          "etiv_covariate": {"type": "boolean"},
          "hemisphere": {"type": "string", "enum": ["pooled", "none"]}
        }
      }
    },

    "design": {
      "type": "object",
      "required": ["participants", "roles"],
      "additionalProperties": false,
      "properties": {
        "participants": {"type": "string"},
        "roles": {
          "type": "object",
          "required": ["subject", "group"],
          "additionalProperties": false,
          "properties": {
            "subject": {"type": "string"},
            "group": {"type": "string"},
            "age": {"type": "string"},
            "sex": {"type": "string"}
          }
        },
        "contrasts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervention": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "control": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        },
        "factorial": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        },
        "covariates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["col", "type"],
            "additionalProperties": false,
            "properties": {
              "col": {"type": "string"},
              "type": {"type": "string", "enum": ["numeric", "factor"]},
              "transform": {"type": "string", "enum": ["none", "z", "rank_z"], "default": "none"},
              "as": {"type": "string"}
            }
          }
        },
        "moderators": {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string"},
            "baseline_cols": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },

    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "measures"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "Optional discriminator for the output folder name (<id>_<measure>), needed when multiple analyses share the same test type against the same measure (e.g. two rm_anova variants). Defaults to the test name."
          },
          "test": {
            "type": "string",
            "enum": [
              "lmm", "change_ancova", "multivariate", "loso", "moderator",
              "factorial", "rm_anova", "time_pattern", "coupled_change",
              "heterogeneity", "traj_clusters", "pointwise", "hierarchical",
              "ml", "lgm"
            ]
          },
          "measures": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },

    "output": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {"type": "string"},
        "alpha": {"type": "number", "default": 0.05, "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "fdr_within": {"type": "string", "enum": ["measure", "analysis"], "default": "measure"}
      }
    }
  }
}
