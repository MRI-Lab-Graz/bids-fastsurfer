{
  "study": {
    "id": "af19",
    "label": "134 AF19 dance intervention (ballet+contemporary vs control), 3-timepoint"
  },

  "datasets": {
    "freesurfer": {
      "path": "/data/local/134_AF19/derivatives/fastsurfer",
      "datalad": false,
      "dir_pattern": "^(?P<base>sub-[^/_]+)_(?P<ses>ses-[^/]+)\\.long\\.(?P=base)$"
    }
  },

  "sessions": {
    "include": ["ses-1", "ses-2", "ses-3"],
    "baseline": "ses-1"
  },

  "measures": [
    {
      "name": "hippo",
      "dataset": "freesurfer",
      "source": "hippo-amygdala",
      "profile": "volume",
      "region_filter": { "prefix": "hippo:" },
      "roi_set": ["Whole_hippocampus", "GC-ML-DG", "CA1", "CA3", "CA4", "subiculum", "molecular_layer_HP"]
    }
  ],

  "design": {
    "participants": "/data/local/134_AF19/participants.tsv",
    "roles": {
      "subject": "subject_id",
      "group": "group",
      "age": "age",
      "sex": "sex"
    },
    "contrasts": {
      "intervention": ["ballet", "contemporary"],
      "control": ["control"]
    },
    "covariates": [
      { "col": "age", "type": "numeric", "transform": "rank_z", "as": "age_z" },
      { "col": "sex", "type": "factor" }
    ],
    "moderators": {
      "file": "/data/local/134_AF19/moderators.tsv",
      "baseline_cols": ["psqi_global", "pss_total", "ads_score"]
    }
  },

  "analyses": [
    { "test": "lmm",           "measures": ["hippo"] },
    { "test": "change_ancova", "measures": ["hippo"] }
  ],

  "output": {
    "root": "results/flex/af19",
    "alpha": 0.05,
    "fdr_within": "measure"
  }
}
