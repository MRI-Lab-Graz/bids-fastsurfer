{
  "study": {
    "id": "REPLACE_ME",
    "label": "One-line human-readable study description"
  },

  "datasets": {
    "freesurfer": {
      "path": "/path/to/derivatives/freesurfer",
      "datalad": true,
      "dir_pattern": "^(?P<base>sub-[^/_]+)_(?P<ses>ses-[^/]+)\\.long\\.(?P=base)$"
    }
  },

  "sessions": {
    "include": ["ses-1", "ses-2"],
    "baseline": "ses-1"
  },

  "measures": [
    {
      "name": "hippo",
      "dataset": "freesurfer",
      "source": "hippo-amygdala",
      "profile": "volume",
      "region_filter": { "prefix": "hippo:" },
      "roi_set": ["Whole_hippocampus", "GC-ML-DG", "CA1", "CA3", "CA4", "subiculum", "molecular_layer_HP"]
    }
  ],

  "design": {
    "participants": "/path/to/participants.tsv",
    "roles": {
      "subject": "subject_id",
      "group": "group",
      "age": "age",
      "sex": "sex"
    },
    "contrasts": {
      "intervention": ["REPLACE_WITH_GROUP_LEVELS"],
      "control": ["REPLACE_WITH_CONTROL_LEVEL"]
    },
    "covariates": [
      { "col": "age", "type": "numeric", "transform": "rank_z", "as": "age_z" },
      { "col": "sex", "type": "factor" }
    ]
  },

  "analyses": [
    { "test": "lmm", "measures": ["hippo"] }
  ],

  "output": {
    "root": "results/flex/REPLACE_ME",
    "alpha": 0.05,
    "fdr_within": "measure"
  }
}
